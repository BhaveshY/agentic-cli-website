{
  "name": "neural-clash",
  "version": "1.0.0",
  "description": "NEURAL CLASH - A 3D strategic battle game where you duel an AI agent with humor and attitude",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "agent:cli": "tsx scripts/agent-cli.ts",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.170.0",
    "express": "^4.21.0",
    "ws": "^8.18.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "tsx": "^4.19.0",
    "concurrently": "^9.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0"
  }
}
